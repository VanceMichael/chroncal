+		t.Fatalf("first todo hard-deleted despite rollback: %v", err)
+	}
+	if _, err := todos.GetIncludingDeleted(ctx, td3.ID); err != nil {
+		t.Fatalf("last todo hard-deleted despite rollback: %v", err)
