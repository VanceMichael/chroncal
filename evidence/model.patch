+func TestRestoreBatch_InstanceLogAndOverrideRowBothOrders(t *testing.T) {
+	db, q := testutil.NewTestDB(t)
+	events := event.NewService(db, q)
+	todos := todo.NewService(db, q)
+	journals := journal.NewService(db, q)
