+	dstRef := serverURL + "/caldst/"
+	if err := q.LinkCalendarToAccount(ctx, storage.LinkCalendarToAccountParams{
+		ID: srcID, AccountID: &srcAcct.ID, RemoteUrl: &srcRef,
