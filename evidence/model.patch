+func parseCheckRecords(t *testing.T, out []byte) []map[string]any {
+	t.Helper()
+	var records []map[string]any
+	if err := json.Unmarshal(out, &records); err != nil {
+		t.Fatalf("parse check JSON %q: %v", string(out), err)
+	}
+	return records
+}
